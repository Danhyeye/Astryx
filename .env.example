NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_API_URL_BACKEND=

# NextAuth Google sign-in (verified emails with active rows in public.app_users).
# Basic Google sign-in is NOT restricted by Google Cloud test users.
# Manage app access in Supabase Table Editor > app_users.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Optional separate OAuth client; otherwise GOOGLE_CLIENT_ID/SECRET below are used.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Add this authorized redirect URI to the Google OAuth client:
# http://localhost:3000/api/auth/callback/google
# In production also set AUTH_URL=https://your-domain.example and register
# https://your-domain.example/api/auth/callback/google with Google.

# Google Calendar OAuth.
# Create a Google OAuth Web application client and add this redirect URI:
# http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_ID=primary
